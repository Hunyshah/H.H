# ---------------------------------------------------------------------------
# H.H Associate — environment variables
# Copy to `.env.local` for local development and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Never put a secret in a NEXT_PUBLIC_ variable: those are sent to browsers.
# ---------------------------------------------------------------------------

# Public site URL, no trailing slash. Used for canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) -------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe for browsers; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret (service role) key. SERVER ONLY: used to insert leads. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email notifications (Resend) ------------------------------------------
# API key from resend.com. If empty, leads are still saved but no email is sent.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "H.H Associate <leads@hhassociate.pk>"
LEAD_EMAIL_FROM=
# Where new-lead notifications are sent (comma-separated for several).
LEAD_EMAIL_TO=

# --- Cloudflare Turnstile (spam protection) --------------------------------
# Site key (public) and secret key (server). If both are empty, verification is
# skipped (local development only — always set them in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics: each one loads only when its value is set ------------------
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta Pixel ID (digits only)
NEXT_PUBLIC_META_PIXEL_ID=
# Set to "1" to enable Vercel Web Analytics (enable it in the Vercel dashboard too).
NEXT_PUBLIC_VERCEL_ANALYTICS=

# --- Vercel Cron ------------------------------------------------------------
# Random secret (e.g. `openssl rand -hex 32`). Vercel sends it to /api/keepalive,
# which pings Supabase daily so the free-tier project is never paused.
CRON_SECRET=
